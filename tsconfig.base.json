{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    // Enable when current error backlog is clear:
    // "noUncheckedIndexedAccess": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@c8c/workflow-runner": ["./packages/workflow-runner/src/index.ts"],
      "@c8c/workflow-runner/*": ["./packages/workflow-runner/src/*"],
      "@c8c-ai/cli": ["./packages/workflow-cli/src/index.ts"],
      "@c8c-ai/cli/*": ["./packages/workflow-cli/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "release", "out"]
}
