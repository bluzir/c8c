{
  "name": "c8c",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/shared-claude-tools/packages/*"
  ],
  "description": "Open-source skill operations for Claude Code",
  "main": "out/main/index.js",
  "scripts": {
    "build:shared": "node scripts/build-shared-if-needed.mjs",
    "build:shared:force": "node scripts/build-shared-if-needed.mjs --force",
    "postinstall": "node scripts/patch-electron-name.js && node scripts/patch-acp-stack.mjs",
    "prepare": "husky",
    "predev": "npm run build:shared",
    "dev": "electron-vite dev",
    "dev:telemetry": "C8C_TELEMETRY_LOCAL_TEST=1 electron-vite dev",
    "prebuild": "npm run build:shared",
    "build": "electron-vite build",
    "prebuild:test-mode": "npm run build:shared",
    "build:test-mode": "C8C_TEST_MODE=1 electron-vite build",
    "preview": "electron-vite preview",
    "pretest": "npm run build:shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0 --quiet --ignore-pattern '**/dist/**' --ignore-pattern '**/out/**' --ignore-pattern '**/coverage/**' --ignore-pattern '**/release/**'",
    "lint:fix": "eslint . --fix --ignore-pattern '**/dist/**' --ignore-pattern '**/out/**' --ignore-pattern '**/coverage/**' --ignore-pattern '**/release/**'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "canon:check": "node scripts/check-canon-vocabulary.mjs",
    "smoke:electron": "npm run build:test-mode && node scripts/run-electron-smoke.mjs",
    "smoke:electron:ci": "npm run build:test-mode && node scripts/run-electron-smoke.mjs --json --no-keep-artifacts-on-success",
    "codex:download": "node scripts/download-codex-binary.mjs --version=0.114.0",
    "codex:download:all": "node scripts/download-codex-binary.mjs --version=0.114.0 --all",
    "prepackage": "npm run canon:check && npm test && npm run build",
    "package": "electron-builder --dir",
    "prepackage:mac": "npm run canon:check && npm test && npm run build",
    "package:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.45",
    "@c8c/workflow-runner": "workspace:*",
    "@claude-tools/mcp-search-proxy": "workspace:*",
    "@mcpc-tech/acp-ai-provider": "^0.2.8",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@zed-industries/codex-acp": "^0.10.0",
    "ai": "^6.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "gray-matter": "^4.0.3",
    "jotai": "^2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@types/node": "^20.17.50",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "~39.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.3.4",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": "prettier --write"
  },
  "overrides": {
    "@types/node": "^20.17.50",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "build": {
    "appId": "app.c8c",
    "productName": "c8c",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin/${platform}-${arch}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
      "node_modules/@zed-industries/codex-acp/**/*",
      "node_modules/@zed-industries/codex-acp-*/**/*"
    ],
    "protocols": [
      {
        "name": "c8c Protocol",
        "schemes": [
          "c8c"
        ]
      }
    ],
    "publish": {
      "provider": "github"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
